# Local evaluation only. Use a different key if you change the network setup.
TIMESERIES_API_KEY=local-evaluation-only
# Pin the model weights to a complete Hugging Face commit SHA.
TIMESFM_REVISION=43046b85ec22d584a13f8098c2ed39c889e129c2
TIMESTRAL_REVISION=9874d252ab0aae16f7f7c999f98f98d6ad7d8365
# Select the server startup model and the matching ClickHouse UDF request model.
TIMESERIES_MODEL=timesfm-3.0
# Host ports; change these if another service uses them.
MODEL_PORT=8091
CLICKHOUSE_PORT=8125
